# Public client config for the hosted Inclusion app (inclusion-hybridai).
# These are Firebase web config values and the public reCAPTCHA Enterprise
# site key. They are not privileged secrets. Copy this file to .env.local
# for a local build.
#
# Leave VITE_APPCHECK_DEBUG=false. Do not add an App Check debug token.
# The production reCAPTCHA key does not include localhost, so a local
# build may fall back to the bundled trial snapshot. That is expected.
# The live App Check and Firestore path is https://inclusion-hybridai.web.app.

VITE_FIREBASE_API_KEY=AIzaSyBB5y_Ksm5dgoK23PMZVFMKSKXoB8Kbl3o
VITE_FIREBASE_AUTH_DOMAIN=inclusion-hybridai.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=inclusion-hybridai
VITE_FIREBASE_STORAGE_BUCKET=inclusion-hybridai.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=643759140603
VITE_FIREBASE_APP_ID=1:643759140603:web:528ba958d6a8785dae4a5e
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=6LdiGxwuAAAAACDvV0XjnLCTPSBe7U1rAlJ8Gqec
VITE_APPCHECK_DEBUG=false
VITE_APPCHECK_DEBUG_TOKEN=
